# GameBar

# CPU stats
allow system_app proc_stat:file r_file_perms;

# Thermal sensors (CPU/GPU/Battery temps)
allow system_app sysfs_therm:dir search;
allow system_app sysfs_therm:file r_file_perms;

# GPU utilization
allow system_app sysfs_ged:dir search;
allow system_app sysfs_ged:file r_file_perms;

# GPU frequency
allow system_app vendor_sysfs_gpu:file r_file_perms;

# Bypass Charging
allow system_app vendor_sysfs_usb_supply:dir search;
allow system_app vendor_sysfs_usb_supply:file rw_file_perms;
